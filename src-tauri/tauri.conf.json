{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macyad",
  "version": "0.1.0",
  "identifier": "com.orloff.macyad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Macyad",
        "width": 1120,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app"
  }
}
